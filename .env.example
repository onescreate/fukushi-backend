# サーバー
PORT=8080

# CORS 許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:5173

# データベース（Step 0-3 で使用。Postgres.app のローカルDB接続文字列）
# 例: postgresql://USER:PASSWORD@localhost:5432/fukushi
DATABASE_URL=

# Firebase Admin SDK（サービスアカウント鍵JSONのパス。鍵ファイルはコミットしないこと）
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
FIREBASE_PROJECT_ID=

# Firebase Web APIキー（公開情報。動作検証スクリプト等で使用）
FIREBASE_WEB_API_KEY=

# キオスク操作トークンの署名鍵
KIOSK_TOKEN_SECRET=
