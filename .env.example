# サーバー
PORT=8080

# CORS 許可オリジン（カンマ区切り）
CORS_ORIGINS=http://localhost:5173

# データベース（Step 0-3 で使用。Postgres.app のローカルDB接続文字列）
# 例: postgresql://USER:PASSWORD@localhost:5432/fukushi
DATABASE_URL=

# Firebase Admin SDK（Step 0-4 で使用。サービスアカウント鍵JSONのパス）
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json
