// ============================================================
//  就労支援施設 利用者管理システム — DBスキーマ
//  Phase 0: テナント（法人→店舗）＋認証コア
//  詳細は docs/01_システム設計書.md 6章を参照
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 列挙型 ----------

/// 職員のロール（権限の束。設計書5.2）
enum Role {
  system_admin // ベンダー（全法人）
  corporation_admin // 法人管理者（自法人・全店舗）
  facility_admin // 店舗管理者（割当店舗）
  staff // 一般スタッフ（割当店舗）
}

/// 施設のサービス種別（加算の適用可否に影響）
/// サービス種別マスタ（管理者が自由に追加・編集できる）。facilities.service_type にこの name を保存。
model ServiceTypeOption {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_types")
}

/// 法人・店舗・端末の状態
enum EntityStatus {
  active
  inactive
}

/// 利用者の状態
enum UserStatus {
  active // 利用中
  withdrawn // 退所
}

// ---------- テナント ----------

/// 法人（テナント最上位）
model Corporation {
  id            String       @id @default(uuid()) @db.Uuid
  /// ポータル(会計)の corp_id。ポータル法人を単一マスタとして参照するための紐付け。
  externalCorpId String?     @unique @map("external_corp_id")
  name          String
  status        EntityStatus @default(active)
  establishedOn DateTime?    @map("established_on") @db.Date
  postalCode    String?      @map("postal_code")
  prefecture    String?
  city          String?
  addressLine   String?      @map("address_line")
  phone         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  facilities  Facility[]
  staff       Staff[]
  users       User[]
  taxSettings TaxSetting[]

  @@map("corporations")
}

/// 店舗／施設
model Facility {
  id            String       @id @default(uuid()) @db.Uuid
  corporationId String       @map("corporation_id") @db.Uuid
  /// ポータル(会計)の shop_id。ポータル店舗を「福祉事業所」として指定するための紐付け。
  externalShopId String?     @unique @map("external_shop_id")
  name          String
  /// サービス種別（ServiceTypeOption.name を保存する自由記述）
  serviceType   String?      @map("service_type")
  mealsEnabled  Boolean      @default(false) @map("meals_enabled")
  mealChangeDeadlineDays Int  @default(14) @map("meal_change_deadline_days") // 利用日までこの日数以内は「申請」扱い＋キャンセル料対象
  email         String?
  status        EntityStatus @default(active)
  remarks       String?
  establishedOn DateTime?    @map("established_on") @db.Date
  postalCode    String?      @map("postal_code")
  prefecture    String?
  city          String?
  addressLine   String?      @map("address_line")
  phone         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  corporation       Corporation         @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  users             User[]
  staffRoles        StaffFacilityRole[]
  kioskDevices      KioskDevice[]
  attendanceSetting AttendanceSetting?
  mealPricings      MealPricing[]
  invoiceSettings   InvoiceSetting[]
  mealDeliveries    MealDelivery[]
  billingClosings   BillingClosing[]
  announcements     Announcement[]

  @@index([corporationId])
  @@map("facilities")
}

// ---------- 認証：職員 ----------

/// 職員（管理画面ユーザー）。認証はFirebase（emailベース）。
model Staff {
  id            String       @id @default(uuid()) @db.Uuid
  corporationId String       @map("corporation_id") @db.Uuid
  firebaseUid   String?      @unique @map("firebase_uid")
  lastName      String       @map("last_name")
  firstName     String       @map("first_name")
  email         String       @unique
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  corporation   Corporation         @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  facilityRoles StaffFacilityRole[]

  @@index([corporationId])
  @@map("staff")
}

/// 職員×店舗×ロールの割当（facilityId=null は法人全体を意味する）
model StaffFacilityRole {
  id         String   @id @default(uuid()) @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  facilityId String?  @map("facility_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  staff    Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([staffId, facilityId, role])
  @@index([facilityId])
  @@map("staff_facility_roles")
}

// ---------- 認証：利用者 ----------

/// 利用者。自宅ログイン=Firebase(firebaseUid) / 施設タブレット=PIN(pinCode:bcryptハッシュ)
model User {
  id             String     @id @default(uuid()) @db.Uuid
  corporationId  String     @map("corporation_id") @db.Uuid
  facilityId     String     @map("facility_id") @db.Uuid
  loginId        String     @unique @map("login_id")
  firebaseUid    String?    @unique @map("firebase_uid")
  lastName       String     @map("last_name")
  firstName      String     @map("first_name")
  kana           String?
  pinCode        String     @map("pin_code")
  certNumber     String?    @map("cert_number")
  useSpecialMealFee Boolean @default(false) @map("use_special_meal_fee") // true=店舗の特別食事料金 / false=店舗の通常食事料金
  heightCm       Decimal?   @map("height_cm") @db.Decimal(5, 2)
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  corporation Corporation  @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  schedules      Schedule[]
  attendances    Attendance[]
  meals          Meal[]
  billingRecords BillingRecord[]
  healthRecords  HealthRecord[]
  closingOps     ClosingOperation[]

  @@index([corporationId])
  @@index([facilityId])
  @@map("users")
}

// ---------- タブレット端末 ----------

/// 施設に置く打刻用タブレット端末（端末認証に使用）
model KioskDevice {
  id          String       @id @default(uuid()) @db.Uuid
  facilityId  String       @map("facility_id") @db.Uuid
  deviceToken String       @unique @map("device_token")
  label       String
  status      EntityStatus @default(active)
  lastUsedAt  DateTime?    @map("last_used_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("kiosk_devices")
}

// ---------- 通所予定・打刻（Phase 2） ----------

/// 予定の状態
enum ScheduleStatus {
  pending // 承認待ち
  approved // 承認済
  rejected // 却下
}

/// 予定に付随するイベント種別（中抜け等）
enum ScheduleEventType {
  break_out // 中抜け
  practice // 実習
  other
}

/// 打刻実績の状態
enum AttendanceStatus {
  present // 出席
  absent // 欠席
}

/// 通所予定（利用者×日付で1件）
model Schedule {
  id            String         @id @default(uuid()) @db.Uuid
  corporationId String         @map("corporation_id") @db.Uuid
  facilityId    String         @map("facility_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  planDate      DateTime       @map("plan_date") @db.Date
  planIn        String?        @map("plan_in") // "HH:MM"
  planOut       String?        @map("plan_out") // "HH:MM"
  status        ScheduleStatus @default(approved)
  note          String?
  createdBy     String?        @map("created_by") @db.Uuid
  approvedBy    String?        @map("approved_by") @db.Uuid
  approvedAt    DateTime?      @map("approved_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  details ScheduleDetail[]

  @@unique([userId, planDate])
  @@index([facilityId, planDate])
  @@map("schedules")
}

/// 中抜け等（外出・戻りの予定/実績）
model ScheduleDetail {
  id         String            @id @default(uuid()) @db.Uuid
  scheduleId String            @map("schedule_id") @db.Uuid
  eventType  ScheduleEventType @map("event_type")
  plannedOut String?           @map("planned_out") // "HH:MM"
  plannedIn  String?           @map("planned_in") // "HH:MM"
  actualOut  String?           @map("actual_out")
  actualIn   String?           @map("actual_in")
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("schedule_details")
}

/// 打刻実績（利用者×日付で1件）
model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  corporationId String           @map("corporation_id") @db.Uuid
  facilityId    String           @map("facility_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  workDate      DateTime         @map("work_date") @db.Date
  clockIn       DateTime?        @map("clock_in")
  clockOut      DateTime?        @map("clock_out")
  status          AttendanceStatus @default(present)
  isLate          Boolean          @default(false) @map("is_late")
  isEarlyLeave    Boolean          @default(false) @map("is_early_leave")
  absenceReason   String?          @map("absence_reason")
  lateReason      String?          @map("late_reason")
  earlyLeaveReason String?         @map("early_leave_reason")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([facilityId, workDate])
  @@map("attendances")
}

/// 打刻の判定設定（店舗ごと・遅刻/早退の猶予分）
model AttendanceSetting {
  id                     String   @id @default(uuid()) @db.Uuid
  facilityId             String   @unique @map("facility_id") @db.Uuid
  lateGraceMinutes       Int      @default(0) @map("late_grace_minutes")
  earlyLeaveGraceMinutes Int      @default(0) @map("early_leave_grace_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

// ---------- 食事管理（Phase 3） ----------

/// 食事予約の状態
enum MealStatus {
  reserved // 予約
  cancelled // キャンセル（キャンセル料あり）
  revoked // 取消（無料）
  eaten // 喫食済
}

/// 食事予約の承認状態（利用者本人の申請時に使用。管理側操作は常に approved）
enum MealApprovalStatus {
  pending // 承認待ち
  approved // 承認済み（即確定含む）
  rejected // 却下
}

/// 承認待ちの申請種別（予約 or キャンセル）
enum MealRequestType {
  reserve // 予約の申請
  cancel // キャンセルの申請
}

/// 消費税の区分（品目別に標準/軽減を持てる）
enum TaxCategory {
  standard // 標準税率
  reduced // 軽減税率
}

/// 消費税の端数処理
enum TaxRounding {
  floor // 切り捨て
  round // 四捨五入
  ceil // 切り上げ
}

/// 食事予約（利用者×日付で1件）
model Meal {
  id            String     @id @default(uuid()) @db.Uuid
  corporationId String     @map("corporation_id") @db.Uuid
  facilityId    String     @map("facility_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  mealDate      DateTime   @map("meal_date") @db.Date
  status        MealStatus @default(reserved)
  amount        Int        @default(0) // 予約時にスナップショットした料金（税込）
  situation     String?
  approvalStatus MealApprovalStatus @default(approved) @map("approval_status")
  requestType   MealRequestType?    @map("request_type") // 承認待ちのとき、予約 or キャンセルのどちらの申請か
  createdBy     String?    @map("created_by") @db.Uuid
  updatedBy     String?    @map("updated_by") @db.Uuid
  approvedBy    String?    @map("approved_by") @db.Uuid
  approvedAt    DateTime?  @map("approved_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mealDate])
  @@index([facilityId, mealDate])
  @@index([facilityId, approvalStatus])
  @@map("meals")
}

/// 食事料金（店舗ごと・適用開始日つきの履歴型）
model MealPricing {
  id            String   @id @default(uuid()) @db.Uuid
  corporationId String   @map("corporation_id") @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  effectiveDate DateTime @map("effective_date") @db.Date // この日以降に適用
  mealFee       Int      @default(0) @map("meal_fee") // 通常の食事料金（内税・円）
  specialMealFee Int     @default(0) @map("special_meal_fee") // 特別食事料金（補助なし等・内税・円）
  cancelFee     Int      @default(0) @map("cancel_fee") // キャンセル料（内税・円）
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, effectiveDate])
  @@index([facilityId, effectiveDate])
  @@map("meal_pricings")
}

/// 消費税設定（法人ごと・区分別・適用開始日つきの履歴型）
model TaxSetting {
  id               String      @id @default(uuid()) @db.Uuid
  corporationId    String      @map("corporation_id") @db.Uuid
  effectiveDate    DateTime    @map("effective_date") @db.Date // この日以降に適用
  category         TaxCategory @default(reduced) // 食事は既定で軽減税率
  rate             Int         @default(8) // 税率（％）
  priceIncludesTax Boolean     @default(true) @map("price_includes_tax") // 内税/外税（既定=内税）
  rounding         TaxRounding @default(floor) // 端数処理（既定=切り捨て）
  createdBy        String?     @map("created_by") @db.Uuid
  updatedBy        String?     @map("updated_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  corporation Corporation @relation(fields: [corporationId], references: [id], onDelete: Cascade)

  @@unique([corporationId, category, effectiveDate])
  @@index([corporationId, effectiveDate])
  @@map("tax_settings")
}

/// 食事の納品（店舗×日で1件）。発注数は meals から都度集計するため保持しない。
model MealDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  corporationId String   @map("corporation_id") @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  deliveryDate  DateTime @map("delivery_date") @db.Date
  deliveryCount Int      @default(0) @map("delivery_count") // 実納品数（手入力）
  note          String?
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, deliveryDate])
  @@index([facilityId, deliveryDate])
  @@map("meal_deliveries")
}

/// 適格請求書の発行者情報（店舗ごと・適用開始日つきの履歴型）。
model InvoiceSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  corporationId      String   @map("corporation_id") @db.Uuid
  facilityId         String   @map("facility_id") @db.Uuid
  effectiveDate      DateTime @map("effective_date") @db.Date // この日以降に適用
  issuerName         String   @map("issuer_name") // 発行者（事業者名）
  registrationNumber String?  @map("registration_number") // 適格請求書発行事業者登録番号（T+13桁）
  postalCode         String?  @map("postal_code")
  address            String? // 住所（1行）
  phone              String?
  bankInfo           String?  @map("bank_info") // 振込先（自由記入・複数行可）
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, effectiveDate])
  @@index([facilityId, effectiveDate])
  @@map("invoice_settings")
}

/// 食事の月次請求（利用者×年月で1件）。入金状況を管理する。
/// 金額（食事料金・キャンセル料・消費税）は meals から都度集計するため保持しない。
model BillingRecord {
  id            String    @id @default(uuid()) @db.Uuid
  corporationId String    @map("corporation_id") @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  year          Int
  month         Int // 1-12
  paymentDate   DateTime? @map("payment_date") @db.Date // 入金日（null=未入金）
  note          String?
  closedSnapshot Json?    @map("closed_snapshot") // 月締め時に確定した金額のスナップショット
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([facilityId, year, month])
  @@map("billing_records")
}

/// 健康記録（利用者×年月で1件。体重・身長・BMI用）
model HealthRecord {
  id            String    @id @default(uuid()) @db.Uuid
  corporationId String    @map("corporation_id") @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  year          Int
  month         Int // 1-12
  weightKg      Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  heightCm      Decimal?  @map("height_cm") @db.Decimal(5, 2)
  note          String?
  measuredOn    DateTime? @map("measured_on") @db.Date // 最終測定日
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([facilityId, year, month])
  @@map("health_records")
}

/// 締め業務（実績記録・加算）。利用者×日で1件。食事提供加算は喫食実績から導出。
model ClosingOperation {
  id                  String   @id @default(uuid()) @db.Uuid
  corporationId       String   @map("corporation_id") @db.Uuid
  facilityId          String   @map("facility_id") @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  targetDate          DateTime @map("target_date") @db.Date
  regionalCooperation Boolean  @default(false) @map("regional_cooperation") // 地域連携会議加算
  transitionPrep      Boolean  @default(false) @map("transition_prep") // 移行準備支援加算
  absenceHandling     Boolean  @default(false) @map("absence_handling") // 欠席時対応加算
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetDate])
  @@index([facilityId, targetDate])
  @@map("closing_operations")
}

/// お知らせの配信対象
enum AnnouncementAudience {
  users // 利用者向け
  staff // 職員向け
  all // 両方
}

/// お知らせ（店舗ごと）。配信対象を選んで利用者/職員に掲示する。
model Announcement {
  id            String               @id @default(uuid()) @db.Uuid
  corporationId String               @map("corporation_id") @db.Uuid
  facilityId    String               @map("facility_id") @db.Uuid
  title         String
  body          String
  audience      AnnouncementAudience @default(all)
  publishedOn   DateTime             @map("published_on") @db.Date // 掲載日（この日以降に表示）
  createdBy     String?              @map("created_by") @db.Uuid
  updatedBy     String?              @map("updated_by") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, publishedOn])
  @@map("announcements")
}

/// 月締め（店舗×年月）。この行が存在する間はその月の食事編集をロックし、請求は確定額で固定する。
model BillingClosing {
  id            String   @id @default(uuid()) @db.Uuid
  corporationId String   @map("corporation_id") @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  year          Int
  month         Int // 1-12
  closedBy      String?  @map("closed_by") @db.Uuid
  closedAt      DateTime @default(now()) @map("closed_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, year, month])
  @@map("billing_closings")
}

/// kioskのPIN連続失敗によるロックアウト管理（利用者×店舗）。
/// メモリではなくDBで持つことで、サーバー再起動やCloud Runの複数インスタンス間でも有効にする。
model KioskPinAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  facilityId  String    @map("facility_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  failCount   Int       @default(0) @map("fail_count") // 現在の窓での失敗回数
  firstFailAt DateTime? @map("first_fail_at") // 現在の窓の起点
  lockedUntil DateTime? @map("locked_until") // この時刻まではロック（null=未ロック）
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([facilityId, userId])
  @@map("kiosk_pin_attempts")
}
