// ============================================================
//  就労支援施設 利用者管理システム — DBスキーマ
//  Phase 0: テナント（法人→店舗）＋認証コア
//  詳細は docs/01_システム設計書.md 6章を参照
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 列挙型 ----------

/// 職員のロール（権限の束。設計書5.2）
enum Role {
  system_admin // ベンダー（全法人）
  corporation_admin // 法人管理者（自法人・全店舗）
  facility_admin // 店舗管理者（割当店舗）
  staff // 一般スタッフ（割当店舗）
}

/// 施設のサービス種別（加算の適用可否に影響）
enum ServiceType {
  transition // 就労移行支援
  continuous_a // 就労継続支援A型
  continuous_b // 就労継続支援B型
  other
}

/// 法人・店舗・端末の状態
enum EntityStatus {
  active
  inactive
}

/// 利用者の状態
enum UserStatus {
  active // 利用中
  withdrawn // 退所
}

// ---------- テナント ----------

/// 法人（テナント最上位）
model Corporation {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  status        EntityStatus @default(active)
  establishedOn DateTime?    @map("established_on") @db.Date
  postalCode    String?      @map("postal_code")
  prefecture    String?
  city          String?
  addressLine   String?      @map("address_line")
  phone         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  facilities Facility[]
  staff      Staff[]
  users      User[]

  @@map("corporations")
}

/// 店舗／施設
model Facility {
  id            String       @id @default(uuid()) @db.Uuid
  corporationId String       @map("corporation_id") @db.Uuid
  name          String
  serviceType   ServiceType? @map("service_type")
  mealsEnabled  Boolean      @default(false) @map("meals_enabled")
  email         String?
  status        EntityStatus @default(active)
  remarks       String?
  establishedOn DateTime?    @map("established_on") @db.Date
  postalCode    String?      @map("postal_code")
  prefecture    String?
  city          String?
  addressLine   String?      @map("address_line")
  phone         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  corporation       Corporation         @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  users             User[]
  staffRoles        StaffFacilityRole[]
  kioskDevices      KioskDevice[]
  attendanceSetting AttendanceSetting?

  @@index([corporationId])
  @@map("facilities")
}

// ---------- 認証：職員 ----------

/// 職員（管理画面ユーザー）。認証はFirebase（emailベース）。
model Staff {
  id            String       @id @default(uuid()) @db.Uuid
  corporationId String       @map("corporation_id") @db.Uuid
  firebaseUid   String?      @unique @map("firebase_uid")
  lastName      String       @map("last_name")
  firstName     String       @map("first_name")
  email         String       @unique
  status        EntityStatus @default(active)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  corporation   Corporation         @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  facilityRoles StaffFacilityRole[]

  @@index([corporationId])
  @@map("staff")
}

/// 職員×店舗×ロールの割当（facilityId=null は法人全体を意味する）
model StaffFacilityRole {
  id         String   @id @default(uuid()) @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  facilityId String?  @map("facility_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  staff    Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([staffId, facilityId, role])
  @@index([facilityId])
  @@map("staff_facility_roles")
}

// ---------- 認証：利用者 ----------

/// 利用者。自宅ログイン=Firebase(firebaseUid) / 施設タブレット=PIN(pinCode:bcryptハッシュ)
model User {
  id             String     @id @default(uuid()) @db.Uuid
  corporationId  String     @map("corporation_id") @db.Uuid
  facilityId     String     @map("facility_id") @db.Uuid
  loginId        String     @unique @map("login_id")
  firebaseUid    String?    @unique @map("firebase_uid")
  lastName       String     @map("last_name")
  firstName      String     @map("first_name")
  kana           String?
  pinCode        String     @map("pin_code")
  certNumber     String?    @map("cert_number")
  specialMealFee Int        @default(0) @map("special_meal_fee")
  heightCm       Decimal?   @map("height_cm") @db.Decimal(5, 2)
  status         UserStatus @default(active)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  corporation Corporation  @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  schedules   Schedule[]
  attendances Attendance[]
  meals       Meal[]

  @@index([corporationId])
  @@index([facilityId])
  @@map("users")
}

// ---------- タブレット端末 ----------

/// 施設に置く打刻用タブレット端末（端末認証に使用）
model KioskDevice {
  id          String       @id @default(uuid()) @db.Uuid
  facilityId  String       @map("facility_id") @db.Uuid
  deviceToken String       @unique @map("device_token")
  label       String
  status      EntityStatus @default(active)
  lastUsedAt  DateTime?    @map("last_used_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("kiosk_devices")
}

// ---------- 通所予定・打刻（Phase 2） ----------

/// 予定の状態
enum ScheduleStatus {
  pending // 承認待ち
  approved // 承認済
  rejected // 却下
}

/// 予定に付随するイベント種別（中抜け等）
enum ScheduleEventType {
  break_out // 中抜け
  practice // 実習
  other
}

/// 打刻実績の状態
enum AttendanceStatus {
  present // 出席
  absent // 欠席
}

/// 通所予定（利用者×日付で1件）
model Schedule {
  id            String         @id @default(uuid()) @db.Uuid
  corporationId String         @map("corporation_id") @db.Uuid
  facilityId    String         @map("facility_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  planDate      DateTime       @map("plan_date") @db.Date
  planIn        String?        @map("plan_in") // "HH:MM"
  planOut       String?        @map("plan_out") // "HH:MM"
  status        ScheduleStatus @default(approved)
  note          String?
  createdBy     String?        @map("created_by") @db.Uuid
  approvedBy    String?        @map("approved_by") @db.Uuid
  approvedAt    DateTime?      @map("approved_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  details ScheduleDetail[]

  @@unique([userId, planDate])
  @@index([facilityId, planDate])
  @@map("schedules")
}

/// 中抜け等（外出・戻りの予定/実績）
model ScheduleDetail {
  id         String            @id @default(uuid()) @db.Uuid
  scheduleId String            @map("schedule_id") @db.Uuid
  eventType  ScheduleEventType @map("event_type")
  plannedOut String?           @map("planned_out") // "HH:MM"
  plannedIn  String?           @map("planned_in") // "HH:MM"
  actualOut  String?           @map("actual_out")
  actualIn   String?           @map("actual_in")
  note       String?
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@map("schedule_details")
}

/// 打刻実績（利用者×日付で1件）
model Attendance {
  id            String           @id @default(uuid()) @db.Uuid
  corporationId String           @map("corporation_id") @db.Uuid
  facilityId    String           @map("facility_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  workDate      DateTime         @map("work_date") @db.Date
  clockIn       DateTime?        @map("clock_in")
  clockOut      DateTime?        @map("clock_out")
  status          AttendanceStatus @default(present)
  isLate          Boolean          @default(false) @map("is_late")
  isEarlyLeave    Boolean          @default(false) @map("is_early_leave")
  absenceReason   String?          @map("absence_reason")
  lateReason      String?          @map("late_reason")
  earlyLeaveReason String?         @map("early_leave_reason")
  createdBy     String?          @map("created_by") @db.Uuid
  updatedBy     String?          @map("updated_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([facilityId, workDate])
  @@map("attendances")
}

/// 打刻の判定設定（店舗ごと・遅刻/早退の猶予分）
model AttendanceSetting {
  id                     String   @id @default(uuid()) @db.Uuid
  facilityId             String   @unique @map("facility_id") @db.Uuid
  lateGraceMinutes       Int      @default(0) @map("late_grace_minutes")
  earlyLeaveGraceMinutes Int      @default(0) @map("early_leave_grace_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

// ---------- 食事管理（Phase 3） ----------

/// 食事予約の状態
enum MealStatus {
  reserved // 予約
  cancelled // キャンセル（キャンセル料あり）
  revoked // 取消（無料）
  eaten // 喫食済
}

/// 食事予約（利用者×日付で1件）
model Meal {
  id            String     @id @default(uuid()) @db.Uuid
  corporationId String     @map("corporation_id") @db.Uuid
  facilityId    String     @map("facility_id") @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  mealDate      DateTime   @map("meal_date") @db.Date
  status        MealStatus @default(reserved)
  amount        Int        @default(0)
  situation     String?
  createdBy     String?    @map("created_by") @db.Uuid
  updatedBy     String?    @map("updated_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mealDate])
  @@index([facilityId, mealDate])
  @@map("meals")
}
